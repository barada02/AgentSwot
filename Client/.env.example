# MongoDB Configuration
VITE_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
VITE_MONGODB_DATABASE=agentswot
VITE_MONGODB_COLLECTION_SESSIONS=sessions
VITE_MONGODB_COLLECTION_MESSAGES=messages
VITE_MONGODB_COLLECTION_INFOGRAPHICS=infographics

# Development flags
VITE_ENABLE_STORAGE=true
VITE_DEBUG_STORAGE=true