# AgentSwot Storage Server Environment Configuration

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourApp
DB_NAME=agentswot

# ADK Server Configuration
ADK_BASE_URL=http://127.0.0.1:8000

# Authentication Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production

# Storage Server Configuration
STORAGE_SERVER_HOST=0.0.0.0
STORAGE_SERVER_PORT=8001

# Environment
ENVIRONMENT=development